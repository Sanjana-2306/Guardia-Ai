# ============================================================
# Guardia-AI — Environment Variables Template
# Copy to .env and fill in your values before running
# ============================================================

# ── PostgreSQL (Production only) ────────────────────────────
POSTGRES_USER=guardia
POSTGRES_PASSWORD=changeme_strong_password

# ── JWT ─────────────────────────────────────────────────────
# Must be at least 256-bit (32+ chars). Change this!
JWT_SECRET=GuardiaAI-Super-Secret-Key-2024-Must-Be-At-Least-256-Bits-Long!
JWT_EXPIRATION_MS=86400000

# ── Gemini API (AI Explanation) ─────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Firebase (Real-time risk events) ─────────────────────────
# Path to your firebase-service-account.json downloaded from Firebase Console
# Leave blank to disable Firebase (graceful fallback)
FIREBASE_CREDENTIALS_PATH=

# ── Frontend ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080
